{
  "name": "mypi",
  "version": "0.0.2",
  "description": "PlebbyG's personal Pi agent configurations managed as a Pi git package.",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlebeiusGaragicus/dot-pi.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "presets:check": "node scripts/check-presets.mjs",
    "presets:debug-system-prompts": "bash scripts/debug-system-prompt.sh",
    "presets:test": "node scripts/test-presets.mjs",
    "runtime-env:test": "node scripts/test-runtime-env.mjs",
    "browser:install": "cd utilities/browser-runtime && bun install",
    "browser:build": "cd utilities/browser-runtime && bun run build",
    "browser:test": "cd utilities/browser-runtime && bun test",
    "browser:dev": "cd utilities/browser-runtime && bun run dev"
  },
  "pi": {
    "extensions": [
      "extensions/mypi-branding/index.ts",
      "extensions/preset/index.ts",
      "extensions/tools/workflow-orchestrator.ts",
      "extensions/tools/questionnaire.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": [
      "shared/themes/github-dark-default.json",
      "shared/themes/midnight-ocean.json",
      "shared/themes/nightowl.json",
      "shared/themes/ocean-breeze.json",
      "shared/themes/rose-pine.json",
      "shared/themes/synthwave.json",
      "shared/themes/tokyo-night.json"
    ]
  }
}
